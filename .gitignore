node_modules/
dist/
*.log
.env
.env.local
.DS_Store
*.tsbuildinfo
coverage/
# Local-only prompt root + seeded client workspace (npm run setup:local)
.local/
.karos-workspace/
_to_delete/
# agents/instagram-agent/__tests__/default-template-render.test.ts's scratch outDir —
# has to live inside the repo root (assertInside requires a repo-relative outDir),
# cleaned up in afterEach but ignored here as a backstop against a crashed run.
.tmp-render-test-*/
# Per-run scratch that MUST live under repoRoot, because publish.renderCarousel's
# assertInside only accepts repo-relative paths. Both are written by a real run
# (not only by tests), and in local development repoRoot IS this repo, so without
# these a `npm run dev:server` run leaves downloaded images and materialized
# templates as untracked files.
#   .media-cache    — packages/tools/karos-media's downloads (MEDIA_CACHE_PREFIX)
#   .template-cache — karos-templates' materialized per-run templates
.media-cache/
.template-cache/
# publish.renderCarousel's rendered PNG output, same reasoning.
instagram-output/

# Generated/vendored — mirrored into .claudeignore so the agent skips them too.
#
# LOCKFILES ARE DELIBERATELY NOT HERE. package-lock.json is tracked and the
# Docker build COPYs it; adding it to this file broke the prep build within
# minutes, because with no .gcloudignore present `gcloud builds submit` derives
# the upload filter FROM .gitignore. So this file silently doubles as the build
# context definition. `.gcloudignore` now states that context explicitly, which
# is what decouples the two — but a lockfile still belongs in version control
# regardless.
.next/
.turbo/
.cache/
