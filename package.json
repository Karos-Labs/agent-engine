{
  "name": "agent-engine",
  "private": true,
  "version": "0.0.1",
  "description": "Karos Labs autonomous agent runtime — BaseAgent, durable workflow orchestration, and the shared MCP tool layer. See docs/RFC-01-agent-engine-core.md.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/tools/*",
    "evals",
    "agents/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build-workspaces.mjs",
    "typecheck": "tsc --noEmit",
    "config:inventory": "tsx scripts/config-inventory.ts",
    "check:config": "tsx scripts/config-inventory.ts --check",
    "check:pricing": "tsx scripts/check-model-pricing.ts",
    "check:bq-schema": "tsx scripts/check-bq-insert-schema.ts",
    "check:prompts": "tsx scripts/check-prompts.ts",
    "pretest": "node scripts/check-dist-freshness.mjs && npm run check:pricing",
    "test": "npm run test --workspaces --if-present",
    "build:stale": "node scripts/check-dist-freshness.mjs",
    "check:stale": "node scripts/check-dist-freshness.mjs --check",
    "verify": "npm run typecheck && npm test",
    "setup:local": "tsx scripts/setup-local.ts",
    "dev:server": "tsx watch --env-file=.env apps/agent-server/src/server.ts",
    "start:server": "node --env-file=.env apps/agent-server/dist/server.js",
    "dev:queue-consumer": "tsx watch --env-file=.env apps/agent-server/src/queue-consumer.ts",
    "start:queue-consumer": "node --env-file=.env apps/agent-server/dist/queue-consumer.js",
    "demo:e2e": "tsx scripts/demo-e2e-run.ts",
    "demo:agents": "tsx scripts/demo-agents-run.ts",
    "demo:queue-publish": "tsx --env-file=.env scripts/queue-publish-demo.ts",
    "smoke": "tsx scripts/smoke-test-server.ts",
    "smoke:agent-platform": "tsx --env-file=.env scripts/smoke-agent-platform.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "tsx": "^4.23.12"
  }
}
