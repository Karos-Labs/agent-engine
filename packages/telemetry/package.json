{
  "name": "@agent-engine/telemetry",
  "private": true,
  "version": "0.0.1",
  "description": "OpenTelemetry setup, span helpers, and cost/token calculators shared by every layer.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "node ../../scripts/check-dist-freshness.mjs",
    "test": "npm run typecheck && vitest run"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resource-detector-gcp": "^0.56.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0"
  }
